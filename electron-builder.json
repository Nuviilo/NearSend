{
  "appId": "com.nearsend.desktop",
  "productName": "NearSend",
  "directories": {
    "output": "release"
  },
  "extraMetadata": {
    "main": "electron/main.cjs",
    "description": "Cross-platform peer-to-peer file and text transfer for Android and Windows.",
    "author": "NearSend"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "build/**/*",
    "package.json",
    "!android/**",
    "!gradle/**",
    "!release/**"
  ],
  "win": {
    "icon": "build/icon.ico",
    "signAndEditExecutable": false,
    "target": [
      {
        "target": "portable",
        "arch": ["x64"]
      },
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "portable": {
    "artifactName": "NearSend-Portable.exe"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "artifactName": "NearSend-Setup.exe"
  }
}
